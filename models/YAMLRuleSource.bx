/**
 * Loads rule definitions from a YAML file.
 *
 * Requires the official BoxLang YAML module to be installed in the consuming application:
 * `box install bx-yaml` (or `install-bx-module bx-yaml`). This is deliberately not a hard dependency
 * of RuleBox itself - only install it if you actually use YAMLRuleSource. When the module is absent,
 * load() throws a `RuleBox.YamlModuleMissingException` that says so.
 *
 * bx-yaml 1.0.0 returns EVERY parsed sequence wrapped in one extra single-element array (at every
 * nesting level, e.g. `[a,b]` parses to `[["a","b"]]`). load() detects that and unwraps it so callers
 * always get a flat array of rule-definition structs; a module version that does not wrap is left untouched.
 */
class{

	/**
	 * Path to the YAML file containing an array of rule definitions, or an envelope { rules, facts, enforceFacts, strictFacts }
	 */
	property name="filePath" type="string";

	/**
	 * Constructor
	 *
	 * @filePath Absolute or resolvable path to a YAML file containing an array of rule definitions, or an envelope { rules, facts, enforceFacts, strictFacts }
	 */
	YAMLRuleSource function init( required string filePath ){
		variables.filePath = arguments.filePath
		return this
	}

	/**
	 * @throws RuleBox.YamlModuleMissingException If the bx-yaml module is not installed
	 * @throws RuleBox.RuleSourceParseException If the file is not valid YAML. The message names the file
	 *         and the parse position only - never the file's content.
	 *
	 * @return An array of rule-definition structs, or the envelope struct as written in the file
	 */
	any function load(){
		if( !structKeyExists( getFunctionList(), "yamlDeserializeFile" ) ){
			throw(
				type    : "RuleBox.YamlModuleMissingException",
				message : "YAMLRuleSource requires the BoxLang YAML module, which is not installed. Install it with: box install bx-yaml (or install-bx-module bx-yaml)",
				detail  : "The yamlDeserializeFile() function is not available."
			)
		}

		var parsed = null
		try{
			parsed = yamlDeserializeFile( variables.filePath )
		} catch( any e ){
			// An unreadable or missing file is not a parse error: surface it untouched
			if( !fileExists( variables.filePath ) ){
				rethrow
			}
			// Deliberately NOT including e.message: parsers can echo the file's content
			var position = ""
			try{
				var located = ( e.getCause().getMessage() ?: e.message ).reMatch( "line:?\s*\d+,?\s*column:?\s*\d+" )
				if( located.len() ){
					position = " (#located.last()#)"
				}
			} catch( any ignored ){
				// position is best-effort only
			}
			throw(
				type    = "RuleBox.RuleSourceParseException",
				message = "Could not parse the YAML rule file [#variables.filePath#]#position#."
			)
		}
		return moduleWrapsSequences() ? unwrap( parsed ) : parsed
	}

	/**
	 * Does the installed YAML module wrap every parsed sequence in an extra single-element array?
	 * Probed with an empty sequence: a wrapping module returns `[[]]`, a well-behaved one returns `[]`.
	 */
	private boolean function moduleWrapsSequences(){
		var probe = yamlDeserialize( "[]" )
		return isArray( probe ) && probe.len() == 1 && isArray( probe[ 1 ] )
	}

	/**
	 * Undo the module's sequence wrapping, recursively. Every array is exactly one wrapper element
	 * holding the real array, so the wrapper is removed once per array. The real contents are then
	 * processed in turn, which keeps legitimately nested arrays (a real `[[a]]`) intact.
	 */
	private any function unwrap( required any node ){
		if( isArray( arguments.node ) ){
			var real = ( arguments.node.len() == 1 && isArray( arguments.node[ 1 ] ) ) ? arguments.node[ 1 ] : arguments.node
			var result = []
			for( var item in real ){
				result.append( unwrap( item ) )
			}
			return result
		}
		if( isStruct( arguments.node ) ){
			var copy = [:]
			for( var key, child in arguments.node ){
				copy[ key ] = unwrap( child )
			}
			return copy
		}
		return arguments.node
	}

}
