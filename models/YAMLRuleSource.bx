/**
 * Loads rule definitions from a YAML file.
 *
 * Requires the official BoxLang YAML module to be installed in the consuming application:
 * `box install boxlang-yaml`. This is deliberately not a hard dependency of RuleBox itself - only
 * install it if you actually use YAMLRuleSource.
 */
class{

	/**
	 * Path to the YAML file containing an array of rule definitions
	 */
	property name="filePath" type="string";

	/**
	 * Constructor
	 *
	 * @filePath Absolute or resolvable path to a YAML file containing an array of rule definitions
	 */
	YAMLRuleSource function init( required string filePath ){
		variables.filePath = arguments.filePath
		return this
	}

	/**
	 * @throws RuleBox.RuleSourceParseException If the file is not valid YAML. The message names the file
	 *         and the parse position only - never the file's content.
	 *
	 * @return An array of rule-definition structs
	 */
	array function load(){
		try{
			return yamlDeserializeFile( variables.filePath )
		} catch( any e ){
			// A missing YAML module / unreadable file is not a parse error: surface it untouched
			if( e.message.reFindNoCase( "^Function \[.*\] not found" ) || !fileExists( variables.filePath ) ){
				rethrow
			}
			// Deliberately NOT including e.message: parsers can echo the file's content
			var position = ""
			try{
				var located = ( e.getCause().getMessage() ?: e.message ).reMatch( "line:?\s*\d+,?\s*column:?\s*\d+" )
				if( located.len() ){
					position = " (#located.last()#)"
				}
			} catch( any ignored ){
				// position is best-effort only
			}
			throw(
				type    = "RuleBox.RuleSourceParseException",
				message = "Could not parse the YAML rule file [#variables.filePath#]#position#."
			)
		}
	}

}
