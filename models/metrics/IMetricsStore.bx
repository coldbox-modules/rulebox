/**
 * Contract for a Rule Visualizer metrics persistence store. Implement this and point
 * moduleSettings.rulebox.visualizer.metricsStore at your WireBox mapping to swap out the
 * default InMemoryMetricsStore@rulebox (or the opt-in SQLiteMetricsStore@rulebox).
 */
interface {

	/**
	 * Persist one rule-evaluation event.
	 *
	 * @event { rulebookName, ruleName, state, durationMs, timestamp }, plus, when the state is FAILED,
	 *        { errorType, errorMessage, errorFingerprint, errorCausedBy, errorStackTrace, errorRawStackTrace },
	 *        already trimmed by RuleHealth::errorOf(). Store an error once per distinct errorFingerprint per rule
	 *        and count repeats (RuleHealth::foldError() does this for an array); don't copy the trace per event.
	 */
	void function recordEvent( required struct event )

	/**
	 * Return recorded events, newest first.
	 *
	 * @filters Optional filters: { rulebookName }
	 * @limit Max rows to return
	 *
	 * @return An array of { rulebookName, ruleName, state, durationMs, timestamp } structs, plus
	 *         { errorType, errorMessage, errorFingerprint } on FAILED events (no stack trace; see queryRuleErrors())
	 */
	array function queryEvents( struct filters={}, numeric limit=50 )

	/**
	 * Aggregated stats for one rulebook across all its recorded rules.
	 *
	 * @rulebookName The rulebook to summarize
	 *
	 * @return { rulebookName, totalEvaluations, countsByState, avgDurationMs, totalDurationMs,
	 *         completed, failed, completionRate, errorRate } (see RuleHealth::of() for the definitions)
	 */
	struct function queryRuleBookSummary( required string rulebookName )

	/**
	 * Aggregated stats for a single rule within a rulebook.
	 *
	 * @rulebookName The rule's owning rulebook
	 * @ruleName The rule to summarize
	 *
	 * @return { rulebookName, ruleName, totalEvaluations, countsByState, avgDurationMs, minDurationMs, maxDurationMs,
	 *         lastRunAt, completed, failed, completionRate, errorRate, lastError? }. lastError is
	 *         { type, message, at, fingerprint } for the rule's most recent FAILED evaluation and is absent until one
	 *         happens.
	 */
	struct function queryRuleMetrics( required string rulebookName, required string ruleName )

	/**
	 * Aggregated stats for every rule of a rulebook that has at least one recorded event, so a dashboard
	 * can rank rules by error rate or duration.
	 *
	 * @rulebookName The rulebook whose rules to summarize
	 *
	 * @return An array of queryRuleMetrics() structs, one per rule, in no particular order
	 */
	array function queryAllRuleMetrics( required string rulebookName )

	/**
	 * A rule's distinct errors, most recently seen first. The same error (same fingerprint) is one entry
	 * with a count, however many times it happened.
	 *
	 * @rulebookName The rule's owning rulebook
	 * @ruleName The rule
	 * @limit Max errors to return
	 *
	 * @return An array of { fingerprint, type, message, causedBy, stackTrace, rawStackTrace, count, firstAt, lastAt }
	 */
	array function queryRuleErrors( required string rulebookName, required string ruleName, numeric limit=10 )

	/**
	 * Every distinct rulebook name that has at least one recorded event.
	 */
	array function queryRuleBookNames()

	/**
	 * Clear every recorded event.
	 */
	void function reset()

}
