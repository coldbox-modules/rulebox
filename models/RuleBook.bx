/**
 * A RuleBook object that stores all the rules to execute in a given context against given facts.
 */
class{

	/**
	 * ---------------------------------------------
	 * DI Injections
	 * ---------------------------------------------
	 */

	@inject( "wirebox" )
	property name="wirebox";

	@inject( "logbox:logger:{this}" )
	property name="logger";

	@inject( "RuleEventBus@rulebox" )
	property name="eventBus";

	/**
	 * ---------------------------------------------
	 * Properties
	 * ---------------------------------------------
	 */

	/**
	 * The facts structure for this rulebook
	 */
	property name="facts" type="struct";

	/**
	 * The name of this rulebook, else defaults to empty.
	 */
	property name="name" type="string" default="";

	/**
	 * The result object, where a rulebook can keep track of result across the rule chain
	 */
	property name="result" type="Result";

	/**
	 * The default result value, if expressed using the `withDefaultValue()`
	 */
	property name="defaultResult" type="any";

	/**
	 * Head rule
	 */
	property name="headRule" type="any";

	/**
	 * Tail End rule
	 */
	property name="tailRule" type="any";

	/**
	 * A struct that tracks the states of the rules defined in this rulebook
	 */
	property name="ruleStatusMap" type="struct";

	/**
	 * The rules registered in this rulebook, in the order they were added via addRule(). This is the
	 * source of truth used to rebuild the head/tail execution chain whenever a rule's priority matters.
	 */
	property name="rules" type="array";

	/**
	 * Named actions registered via registerAction(), used to resolve `then` entries loaded via loadRules()
	 */
	property name="actionRegistry" type="struct";

	/**
	 * Named predicates registered via registerPredicate(), used to resolve `when`/`except` references
	 * loaded via loadRules()
	 */
	property name="predicateRegistry" type="struct";

	/**
	 * Per-rule execution metrics, keyed by rule name. Unlike ruleStatusMap, this accumulates across
	 * every run() call on this instance rather than resetting - see getRuleMetrics()/resetMetrics()
	 */
	property name="ruleMetricsMap" type="struct";

	/**
	 * Compiles the condition trees of externally-defined rules into predicates
	 */
	property name="conditionEvaluator";

	// Static lookup map for rule states
	static{
		RULE_STATES = {
			NOT_AVAILABLE 	= "NOT_AVAILABLE",
			EXECUTED      	= "EXECUTED",
			SKIPPED       	= "SKIPPED",
			REGISTERED 	  	= "REGISTERED",
			STOPPED 		= "STOPPED",
			FAILED 			= "FAILED"
		}
	}

	/**
	 * Constructor
	 *
	 * @name A name to give this rulebook, else defaults to empty
	 */
	RuleBook function init( name="" ){
		variables.facts 			= {}
		variables.name 				= arguments.name
		variables.result 			= new Result()
		variables.ruleStatusMap 	= {}
		variables.rules 			= []
		variables.actionRegistry 	= {}
		variables.predicateRegistry = {}
		variables.ruleMetricsMap 	= {}
		variables.conditionEvaluator = new ConditionEvaluator()

		// Expose the static rule states enum on the instance for external access
		this.RULE_STATES = static.RULE_STATES

		return this
	}

	/**
	 * The withDefaultResult method allows a default result value to be specified.
	 * When using the DSL syntax to chain calls, this method should be the first one specified.
	 *
	 * @result The initial value of the stored result
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function withDefaultResult( required result ){
		variables.defaultResult = arguments.result
		variables.result.setDefaultValue( arguments.result )
		variables.result.setValue( arguments.result )
		return this
	}

	/**
	 * Called to define rules in a rulebook, you would usually overwrite this method in your own class
	 * that extends: rulebox.models.RuleBook.
	 */
	void function defineRules(){
		// This method is meant to be overwritten in your own RuleBook class that extends this one.
	}

	/**
	 * The given() method accepts a key/value pair as a Fact for this RuleBook.
	 * The facts passed in will also be applied to all rules added to this RuleBook.
	 *
	 * @name The unique name of the fact
	 * @value The value of the fact
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function given( required name, required value ){
		variables.facts[ arguments.name ] = arguments.value
		return this
	}

	/**
	 * The givenAll() method accepts all the Facts for this RuleBook.
	 * The facts passed in will also be applied to all rules added to this RuleBook.
	 *
	 * @facts The structure of facts to store
	 * @overwrite Overwrite facts if they exist already, defaults to true
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function givenAll( required struct facts, boolean overwrite=true ){
		structAppend( variables.facts, arguments.facts, arguments.overwrite )
		return this
	}

	/**
	 * Shortcut to create a new rule
	 *
	 * @name The name of the rule, else empty.
	 *
	 * @return A new Rule instance
	 */
	Rule function newRule( string name ){
		return wirebox.getInstance( name: "Rule@rulebox", initArguments: arguments )
	}

	/**
	 * Add a rule to the rule book. You can pass in a closure/lambda that represents the rule or an actual Rule object.
	 *
	 * Rules execute in priority order (highest `withPriority()` value first); rules sharing the same
	 * priority execute in the order they were added here. Adding a rule re-derives the entire
	 * execution chain, and so does calling `withPriority()` on a rule that is already added, so priorities
	 * can be set on rules in any order before or after they are added.
	 *
	 * Rule names must be unique within a RuleBook, since the audit trail and the metrics are keyed by
	 * name. Adding a named rule whose name is already taken (names are case-insensitive) throws a
	 * `RuleBox.DuplicateRuleNameException`. Rules without an explicit name get a UUID and never collide.
	 *
	 * @rule A rule object or a closure/lambda that will represent the rule.
	 *
	 * @throws RuleBox.DuplicateRuleNameException If a rule with the same name was already added
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function addRule( required rule ){

		// Determine closure or object?
		if( isClosure( arguments.rule ) || isCustomFunction( arguments.rule ) ){
			var targetRule = newRule()
			arguments.rule( targetRule )
			// Clean it now that it built
			arguments.rule = targetRule
		}

		// Reject a name already registered in this rulebook, before touching any state
		if( len( arguments.rule.getName() ) && variables.ruleStatusMap.keyExists( arguments.rule.getName() ) ){
			throwDuplicateRuleName( arguments.rule.getName() )
		}

		// Link the rule book
		arguments.rule.setRuleBook( this )
		// Track it's status
		variables.ruleStatusMap[ arguments.rule.getName() ] = static.RULE_STATES.REGISTERED

		// Track insertion order and re-derive the priority-ordered execution chain
		variables.rules.append( arguments.rule )
		linkRuleChain()

		return this
	}

	/**
	 * Throw the exception used whenever a rule name is registered twice in this RuleBook
	 *
	 * @name The duplicated rule name
	 */
	private void function throwDuplicateRuleName( required string name ){
		throw(
			type    = "RuleBox.DuplicateRuleNameException",
			message = "A rule named '#arguments.name#' already exists in this RuleBook.",
			detail  = "Rule names must be unique within a RuleBook, as the rule status map and metrics are keyed by name. Give the rule a different name, or leave the name off."
		)
	}

	/**
	 * Remove every rule from this RuleBook, resetting it to a rule-less state - as if freshly
	 * constructed. Registries (registerAction()/registerPredicate()) and rule metrics are untouched.
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function clearRules(){
		variables.rules 		= []
		variables.ruleStatusMap = {}
		structDelete( variables, "headRule" )
		structDelete( variables, "tailRule" )
		return this
	}

	/**
	 * Manually reload this RuleBook's rules from a source: clearRules() followed by loadRules( source ).
	 * Use this to pick up rule changes from a JSON/YAML file or a database table without restarting -
	 * call it whenever you decide it's time, e.g. from a scheduled task or an admin action. RuleBox does
	 * not watch a rule source for changes on its own.
	 *
	 * @source An object exposing array function load()
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function reloadRules( required any source ){
		clearRules()
		return loadRules( arguments.source )
	}

	/**
	 * Re-derive this RuleBook's execution chain from the rules' current priorities. A Rule calls this
	 * automatically when `withPriority()` changes the priority of a rule already attached to this
	 * RuleBook, so you normally never need to call it yourself.
	 *
	 * Ordering is highest priority first; rules sharing a priority keep the order they were added in.
	 * A RuleBook with no rules is left untouched.
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function relinkRules(){
		if( variables.rules.len() ){
			linkRuleChain()
		}
		return this
	}

	/**
	 * Rebuilds the head/tail rule execution chain from `variables.rules`, ordering rules by priority
	 * (highest first) and, for rules sharing the same priority, by the order they were added.
	 */
	private void function linkRuleChain(){
		// Pair each rule with its insertion index so priority ties keep insertion order
		var indexed = []
		variables.rules.each( ( rule, index ) => {
			indexed.append( { rule: rule, index: index } )
		} )

		indexed.sort( ( a, b ) => {
			if( a.rule.getPriority() != b.rule.getPriority() ){
				return b.rule.getPriority() - a.rule.getPriority()
			}
			return a.index - b.index
		} )

		// Relink every rule's nextRule pointer to reflect the new order. The final rule in the new
		// order must have its pointer cleared: it may have been mid-chain before this call (e.g. its
		// priority was lowered after addRule()), and a stale pointer would loop or repeat rules.
		variables.headRule = indexed[ 1 ].rule
		variables.tailRule = indexed[ indexed.len() ].rule
		for( var i = 1; i < indexed.len(); i++ ){
			indexed[ i ].rule.setNextRule( indexed[ i + 1 ].rule )
		}
		variables.tailRule.clearNextRule()
	}

	/**
	 * Register a named action that a rule definition loaded via loadRules() can reference from its
	 * `then` entries (`{ "action": "name", "params": {...} }`).
	 *
	 * Accepts three forms:
	 * - A closure/lambda: `( facts, result, params ) => { ... }`
	 * - An object instance with an `execute( facts, result, params )` method
	 * - A WireBox mapping ID string (e.g. "MyActionService@myModule"), resolved via getInstance() now
	 *
	 * @name The name rule definitions will reference this action by
	 * @action A closure/lambda, an object with execute(), or a WireBox mapping ID string
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function registerAction( required string name, required any action ){
		variables.actionRegistry[ arguments.name ] = resolveRegistryValue( arguments.action )
		return this
	}

	/**
	 * Register a named predicate that a rule definition loaded via loadRules() can reference from its
	 * `when`/`except` (`{ "predicate": "name", "params": {...} }`), for logic too complex for the
	 * condition-tree grammar.
	 *
	 * Accepts three forms:
	 * - A closure/lambda: `( facts, params ) => boolean`
	 * - An object instance with a `test( facts, params )` method
	 * - A WireBox mapping ID string (e.g. "MyPredicateService@myModule"), resolved via getInstance() now
	 *
	 * @name The name rule definitions will reference this predicate by
	 * @predicate A closure/lambda, an object with test(), or a WireBox mapping ID string
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function registerPredicate( required string name, required any predicate ){
		variables.predicateRegistry[ arguments.name ] = resolveRegistryValue( arguments.predicate )
		return this
	}

	/**
	 * If `value` is a plain string, treat it as a WireBox mapping ID and resolve it now. Otherwise
	 * (a closure, lambda, or object instance) return it untouched.
	 */
	private any function resolveRegistryValue( required any value ){
		if( isSimpleValue( arguments.value ) ){
			return wirebox.getInstance( arguments.value )
		}
		return arguments.value
	}

	/**
	 * Load externally-defined rules from a rule source (e.g. JSONRuleSource, YAMLRuleSource,
	 * DBRuleSource, or any object exposing a `load()` method that returns an array of rule-definition
	 * structs) and addRule() each one. Register any named actions/predicates the definitions reference
	 * via registerAction()/registerPredicate() before calling this.
	 *
	 * Named definitions must be unique within the source and must not clash with a rule already in this
	 * RuleBook; otherwise a RuleBox.DuplicateRuleNameException is thrown before any rule is added.
	 *
	 * Each definition struct may contain: name, priority, activeFrom, activeUntil, when, except, then,
	 * stop, using. See the "Externalized Rules" guide for the full schema.
	 *
	 * Every definition is validated as it is built (condition-tree shape, operators, operand types and
	 * activeFrom/activeUntil dates), and a malformed one throws RuleBox.InvalidRuleDefinitionException
	 * naming the rule and the offending path. All definitions are built before any is added, so if any
	 * definition fails to validate or resolve, no rule from this source is added to the book.
	 *
	 * @source An object exposing array function load()
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function loadRules( required any source ){
		var builtRules = []

		// Duplicate names are rejected up front, then every definition is validated and built
		// before the book is touched
		for( var def, index in loadDefinitions( arguments.source ) ){
			ConditionValidator::validate( def, index )

			var rule = def.keyExists( "name" ) ? newRule( def.name ) : newRule()

			if( def.keyExists( "priority" ) ){
				rule.withPriority( def.priority )
			}

			if( def.keyExists( "activeFrom" ) || def.keyExists( "activeUntil" ) ){
				rule.active(
					def.keyExists( "activeFrom" ) ? def.activeFrom : null,
					def.keyExists( "activeUntil" ) ? def.activeUntil : null
				)
			}

			rule.when( resolveCondition( def.keyExists( "when" ) ? def.when : null ) )

			if( def.keyExists( "except" ) ){
				rule.except( resolveCondition( def.except ) )
			}

			var factNames = def.keyExists( "using" ) ? def.using : []
			// A comma-delimited string is accepted too: trim each name and drop empty ones
			if( isSimpleValue( factNames ) ){
				factNames = listToArray( factNames )
					.map( ( name ) => trim( name ) )
					.filter( ( name ) => len( name ) )
			}

			for( var actionClosure in resolveActions( def.keyExists( "then" ) ? def.then : [] ) ){
				// using() pegs to the *next* then() call only, so re-apply it before each one
				if( !factNames.isEmpty() ){
					rule.using( factNames )
				}
				rule.then( actionClosure )
			}

			if( def.keyExists( "stop" ) && def.stop ){
				rule.stop()
			}

			builtRules.append( rule )
		}

		// Only now that every definition built cleanly do we touch the book
		builtRules.each( ( builtRule ) => addRule( builtRule ) )

		return this
	}

	/**
	 * Load the rule definitions from a source, verifying that no named definition repeats a name or
	 * clashes with a rule already in this RuleBook. This runs before any rule is added, so a
	 * `RuleBox.DuplicateRuleNameException` from loadRules() leaves the book unchanged.
	 *
	 * @source An object exposing array function load()
	 *
	 * @throws RuleBox.DuplicateRuleNameException If two definitions, or a definition and an existing rule, share a name
	 */
	private array function loadDefinitions( required any source ){
		var definitions = arguments.source.load()
		var seen        = {}

		for( var def in definitions ){
			if( !isStruct( def ) || !def.keyExists( "name" ) || !isSimpleValue( def.name ) || !len( def.name ) ){
				continue
			}
			if( seen.keyExists( def.name ) || variables.ruleStatusMap.keyExists( def.name ) ){
				throwDuplicateRuleName( def.name )
			}
			seen[ def.name ] = true
		}

		return definitions
	}

	/**
	 * Resolve a `when`/`except` node into a ( facts ) => boolean closure: either a compiled
	 * condition-tree (a struct without a "predicate" key), a registered predicate reference
	 * (`{ "predicate": "name", "params": {...} }`), or "always true" if the node is null.
	 */
	private any function resolveCondition( any node ){
		if( isNull( arguments.node ) ){
			return () => true
		}

		if( isStruct( arguments.node ) && arguments.node.keyExists( "predicate" ) ){
			var name   = arguments.node.predicate
			var params = arguments.node.keyExists( "params" ) ? arguments.node.params : {}

			if( !variables.predicateRegistry.keyExists( name ) ){
				throw(
					type    = "RuleBox.UnregisteredPredicateException",
					message = "No predicate registered under the name '#name#'.",
					detail  = "Register it first via registerPredicate() before calling loadRules()."
				)
			}

			var registered = variables.predicateRegistry[ name ]
			return ( facts ) => {
				if( isClosure( registered ) || isCustomFunction( registered ) ){
					return registered( facts, params )
				}
				return registered.test( facts, params )
			}
		}

		return variables.conditionEvaluator.compile( arguments.node )
	}

	/**
	 * Resolve an array of `then` entries (`{ "action": "name", "params": {...} }`) into an array of
	 * ( facts, result ) => void closures, ready to be handed to Rule.then().
	 */
	private array function resolveActions( required array actions ){
		return arguments.actions.map( ( actionDef ) => {
			var name   = actionDef.action
			var params = actionDef.keyExists( "params" ) ? actionDef.params : {}

			if( !variables.actionRegistry.keyExists( name ) ){
				throw(
					type    = "RuleBox.UnregisteredActionException",
					message = "No action registered under the name '#name#'.",
					detail  = "Register it first via registerAction() before calling loadRules()."
				)
			}

			var registered = variables.actionRegistry[ name ]
			return ( facts, result ) => {
				if( isClosure( registered ) || isCustomFunction( registered ) ){
					registered( facts, result, params )
				} else {
					registered.execute( facts, result, params )
				}
			}
		} )
	}

	/**
	 * Run the rules in this rule book against the registered facts or passed facts
	 *
	 * @facts A structure of name-value pairs representing the facts in this rulebook
	 * @overwrite Overwrite the facts if they exist or not, defaults to true
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function run( struct facts={}, boolean overwrite=true ){
		// Process Facts
		this.givenAll( argumentCollection=arguments )
		// Reset the result for this run, just in case it was left over from a prior run
		// Unconditionally: `ifPresent()` would skip the very cases that need it (no default, or default not yet applied)
		variables.result.reset()

		// Verify if rules are loaded? If not, load them via the `defineRules()` call.
		if( !hasRules() ){
			// Load up the rules
			defineRules()
			// If still no rules, then exit out
			if( !hasRules() ){
				logger.info( "Cannot run a RuleBook (#variables.name#) that has no rules. See ya!" )
				return this
			}
		}

		// Reset the audit trail so it reflects only this invocation, not a prior one
		variables.ruleStatusMap.keyArray().each( ( name ) => {
			variables.ruleStatusMap[ name ] = static.RULE_STATES.REGISTERED
		} )

		// run the chain with the given facts and passed result object
		variables.headRule
			.setResult( variables.result )
			.run( variables.facts )

		return this
	}

	/**
	 * Walk the rule chain evaluating each rule's `when()`/`except()` conditions against the given
	 * facts, without invoking any `then()` consumers or mutating any state: no facts are merged into
	 * the sticky fact store, no result is touched, and the real audit trail (`getRuleStatusMap()`) is
	 * left untouched. Useful for previewing what a real `run()` would do.
	 *
	 * The walk stops at the same point a real `run()` would stop: the first rule whose condition
	 * passes and has `stop()` set. Rules after that point are never reached, so they aren't reported
	 * either - identical to how they'd never appear in the audit trail as anything but `REGISTERED`.
	 *
	 * @facts A structure of name-value pairs representing the facts to evaluate against
	 *
	 * @return An array of structs, one per rule reached in execution order: { name, wouldExecute, wouldStop }
	 */
	array function dryRun( struct facts={} ){
		var report = []

		// Verify if rules are loaded? If not, load them via the `defineRules()` call.
		if( !hasRules() ){
			defineRules()
			if( !hasRules() ){
				return report
			}
		}

		// Build an evaluation-only fact set: sticky facts + the facts passed here, without mutating either
		var evaluationFacts = variables.facts.copy()
		structAppend( evaluationFacts, arguments.facts, true )

		var currentRule = variables.headRule
		while( !isNull( currentRule ) ){
			var ruleReport = currentRule.dryRun( evaluationFacts )
			report.append( ruleReport )

			if( ruleReport.wouldStop ){
				break
			}

			currentRule = currentRule.getNextRule()
		}

		return report
	}

	/**
	 * Verify if we have any rules in this rulebook
	 */
	boolean function hasRules(){
		return !isNull( variables.headRule )
	}

	/**
	 * Get the status of a run rule, if the rule doesn't exist it will return a NOT_AVAILABLE status
	 *
	 * @name The name of the rule
	 */
	string function getRuleStatus( required name ){
		return variables.ruleStatusMap[ arguments.name ] ?: static.RULE_STATES.NOT_AVAILABLE
	}

	/**
	 * Get the execution metrics for a single rule, meant to be dashboard-ready: plain, JSON-serializable
	 * structs. If the rule has never been evaluated (or doesn't exist), an empty-but-shaped metrics
	 * struct is returned rather than throwing - `totalEvaluations` will be `0`.
	 *
	 * Unlike the status map, metrics accumulate across every run() call on this instance - call
	 * resetMetrics() to clear them.
	 *
	 * @name The name of the rule
	 *
	 * @return { name, totalEvaluations, countsByState, totalDurationMs, minDurationMs, maxDurationMs, lastDurationMs, firstRunAt?, lastRunAt? }
	 */
	struct function getRuleMetrics( required string name ){
		return variables.ruleMetricsMap.keyExists( arguments.name ) ? variables.ruleMetricsMap[ arguments.name ] : newMetricsEntry( arguments.name )
	}

	/**
	 * Clear all accumulated rule metrics on this instance back to empty - e.g. from a dashboard's
	 * "reset stats" action. Does not touch rules, registries, or the status map.
	 *
	 * @return This RuleBook instance, to allow for chaining of calls
	 */
	RuleBook function resetMetrics(){
		variables.ruleMetricsMap = {}
		return this
	}

	/**
	 * Record one rule evaluation's outcome into its accumulated metrics. Called once per rule per run()
	 * from Rule.run(), with the same final state written to the status map.
	 *
	 * @name The name of the rule that was evaluated
	 * @state The final RULE_STATES this evaluation ended in (EXECUTED, SKIPPED, STOPPED, or FAILED)
	 * @durationMs How long the evaluation took, in milliseconds
	 */
	void function recordRuleMetric( required string name, required string state, required numeric durationMs ){
		if( !variables.ruleMetricsMap.keyExists( arguments.name ) ){
			variables.ruleMetricsMap[ arguments.name ] = newMetricsEntry( arguments.name )
		}

		var metric = variables.ruleMetricsMap[ arguments.name ]

		metric.countsByState[ arguments.state ] = ( metric.countsByState.keyExists( arguments.state ) ? metric.countsByState[ arguments.state ] : 0 ) + 1
		metric.minDurationMs  = ( metric.totalEvaluations == 0 ) ? arguments.durationMs : min( metric.minDurationMs, arguments.durationMs )
		metric.maxDurationMs  = ( metric.totalEvaluations == 0 ) ? arguments.durationMs : max( metric.maxDurationMs, arguments.durationMs )
		metric.totalDurationMs += arguments.durationMs
		metric.lastDurationMs = arguments.durationMs
		metric.lastRunAt      = now()
		if( !metric.keyExists( "firstRunAt" ) ){
			metric.firstRunAt = metric.lastRunAt
		}
		metric.totalEvaluations++

		// Feeds the Rule Visualizer (dashboard, metrics, live tracker). A cheap no-op unless
		// moduleSettings.rulebox.visualizer.enabled is true - see RuleEventBus@rulebox.
		// Metrics must never fail or double-count a business rule, so a broken event bus is logged and swallowed.
		try{
			variables.eventBus.publish( {
				rulebookName : variables.name,
				ruleName     : arguments.name,
				state        : arguments.state,
				durationMs   : arguments.durationMs,
				timestamp    : dateTimeFormat( metric.lastRunAt, "yyyy-MM-dd'T'HH:mm:ss" )
			} )
		} catch( any e ){
			logger.warn( "RuleBox could not publish the metric event for rule [#arguments.name#] in rulebook [#variables.name#]: #e.message#" )
		}
	}

	/**
	 * Build an empty, zero-valued metrics struct for a rule that hasn't been evaluated yet
	 */
	private struct function newMetricsEntry( required string name ){
		return {
			"name"             : arguments.name,
			"totalEvaluations" : 0,
			"countsByState"    : {},
			"totalDurationMs"  : 0,
			"minDurationMs"    : 0,
			"maxDurationMs"    : 0,
			"lastDurationMs"   : 0
		}
	}

}