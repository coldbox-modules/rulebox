/**
 * Validates externally-defined rule definitions (JSON/YAML/DB) when they are loaded, so a malformed
 * condition tree or date fails fast with a message that names the rule and the offending path,
 * instead of blowing up inside run() - possibly only on the day a short-circuited branch is reached.
 *
 * This only checks the *shape* of a definition against the ConditionEvaluator grammar; it never
 * evaluates anything and does not change how conditions are evaluated at runtime.
 *
 * A stateless static helper: call ConditionValidator::validate( def, index ), no instance needed.
 */
class{

	/**
	 * The operator sets of the ConditionEvaluator grammar. They never change.
	 */
	static {
		// Operators that take a [ path, value ] pair
		COMPARISON_OPERATORS = [ "eq", "neq", "lt", "lte", "gt", "gte" ]
		// Operators that take a non-empty array of condition nodes
		LOGICAL_OPERATORS = [ "and", "or" ]
	}

	/**
	 * Validate a whole rule definition: its `when`/`except` condition trees, its
	 * `activeFrom`/`activeUntil` values and its `description`.
	 *
	 * @def The rule-definition struct, as returned by a rule source's load()
	 * @index The 1-based position of the definition in its source, used to identify unnamed rules
	 *
	 * @throws RuleBox.InvalidRuleDefinitionException If anything in the definition is malformed
	 */
	static void function validate( required struct def, required numeric index ){
		var ruleLabel = ( arguments.def.keyExists( "name" ) && isSimpleValue( arguments.def.name ) && len( arguments.def.name ) )
			? "'#arguments.def.name#'"
			: "##" & arguments.index & " (unnamed)"

		for( var key in [ "when", "except" ] ){
			// A null/absent node means "always true" (when) or "no exception" (except)
			if( arguments.def.keyExists( key ) && !isNull( arguments.def[ key ] ) ){
				static.validateNode( arguments.def[ key ], key, ruleLabel, true )
			}
		}

		if( arguments.def.keyExists( "description" ) && !isSimpleValue( arguments.def.description ?: "" ) ){
			static.fail( ruleLabel, "description", "must be a string (received: #static.describe( arguments.def.description )#)" )
		}

		for( var key in [ "activeFrom", "activeUntil" ] ){
			if( arguments.def.keyExists( key ) && !isNull( arguments.def[ key ] ) && !isDate( arguments.def[ key ] ) ){
				static.fail(
					ruleLabel,
					key,
					"is not a parseable date/time (received: #static.describe( arguments.def[ key ] )#)"
				)
			}
		}
	}

	/**
	 * Validate one condition node, recursing into and/or/not children.
	 *
	 * @node The node to check
	 * @path The path to this node from the rule definition root, e.g. when.and[2]
	 * @ruleLabel The pre-formatted rule identifier used in error messages
	 * @topLevel True only for the root of a when/except tree, where predicate references are allowed
	 */
	private static void function validateNode( required any node, required string path, required string ruleLabel, boolean topLevel = false ){
		if( !isStruct( arguments.node ) ){
			static.fail( arguments.ruleLabel, arguments.path, "must be a struct with exactly one operator key (received: #static.describe( arguments.node )#)" )
		}

		// Registered-predicate reference: { "predicate": "name", "params": {...} }
		if( arguments.node.keyExists( "predicate" ) ){
			if( !arguments.topLevel ){
				static.fail( arguments.ruleLabel, arguments.path & ".predicate", "predicate references are only supported at the top level of when/except, not nested inside and/or/not" )
			}
			var extraKeys = arguments.node.keyArray().filter( ( k ) => k != "predicate" && k != "params" )
			if( !extraKeys.isEmpty() ){
				static.fail( arguments.ruleLabel, arguments.path, "a predicate reference may only contain 'predicate' and 'params', but also has: #extraKeys.toList( ', ' )#" )
			}
			if( !static.isNonBlankValue( arguments.node.predicate ) ){
				static.fail( arguments.ruleLabel, arguments.path & ".predicate", "must be the name of a registered predicate (received: #static.describe( arguments.node.predicate )#)" )
			}
			return
		}

		if( arguments.node.len() != 1 ){
			static.fail(
				arguments.ruleLabel,
				arguments.path,
				arguments.node.isEmpty()
					? "is an empty struct; a condition node needs exactly one operator key"
					: "has #arguments.node.len()# operator keys (#arguments.node.keyArray().toList( ', ' )#); a condition node needs exactly one"
			)
		}

		var operator     = arguments.node.keyArray()[ 1 ]
		var operatorPath = arguments.path & "." & operator
		var operand      = arguments.node[ operator ]

		if( static.LOGICAL_OPERATORS.contains( operator ) ){
			if( isNull( operand ) || !isArray( operand ) || operand.isEmpty() ){
				static.fail( arguments.ruleLabel, operatorPath, "takes a non-empty array of condition nodes (received: #static.describe( operand )#)" )
			}
			for( var child, i in operand ){
				static.validateNode( child, operatorPath & "[#i#]", arguments.ruleLabel )
			}
			return
		}

		if( operator == "not" ){
			if( isNull( operand ) || !isStruct( operand ) ){
				static.fail( arguments.ruleLabel, operatorPath, "takes a single condition node, not an array or a simple value (received: #static.describe( operand )#)" )
			}
			static.validateNode( operand, operatorPath, arguments.ruleLabel )
			return
		}

		if( static.COMPARISON_OPERATORS.contains( operator ) || operator == "in" ){
			var shape = operator == "in" ? "[ path, [ values... ] ]" : "[ path, value ]"
			if( isNull( operand ) || !isArray( operand ) || operand.len() != 2 ){
				static.fail( arguments.ruleLabel, operatorPath, "takes a 2-element array #shape# (received: #static.describe( operand )#)" )
			}
			if( !static.isNonBlankValue( operand[ 1 ] ) ){
				static.fail( arguments.ruleLabel, operatorPath & "[1]", "must be a non-empty string fact path such as 'applicant.creditScore' (received: #static.describe( operand[ 1 ] )#)" )
			}
			if( operator == "in" && !isArray( operand[ 2 ] ) ){
				static.fail( arguments.ruleLabel, operatorPath & "[2]", "must be an array of values to look for (received: #static.describe( operand[ 2 ] )#)" )
			}
			return
		}

		static.fail(
			arguments.ruleLabel,
			operatorPath,
			"unknown condition operator '#operator#'; supported operators: eq, neq, lt, lte, gt, gte, in, and, or, not"
		)
	}

	/**
	 * Is this a usable name or fact path: a simple value that is not blank?
	 *
	 * @value The value to check
	 */
	private static boolean function isNonBlankValue( any value ){
		return !isNull( arguments.value ) && isSimpleValue( arguments.value ) && len( trim( arguments.value ) ) > 0
	}

	/**
	 * Short, safe description of a value for use in an error message
	 */
	private static string function describe( any value ){
		if( isNull( arguments.value ) ){
			return "null"
		}
		if( isArray( arguments.value ) ){
			return "array of #arguments.value.len()# element(s)"
		}
		if( isStruct( arguments.value ) ){
			return "struct"
		}
		if( isSimpleValue( arguments.value ) ){
			return "'#left( arguments.value, 60 )#'"
		}
		return "an unsupported value"
	}

	/**
	 * Throw the exception every definition check uses, naming the rule, the path to the bad node and the problem.
	 *
	 * @ruleLabel The rule's name in quotes, or "#N (unnamed)" by its position in the source
	 * @path Where in the definition the problem is, such as "when.and[2].lt"
	 * @problem What is wrong
	 *
	 * @throws RuleBox.InvalidRuleDefinitionException Always
	 */
	private static void function fail( required string ruleLabel, required string path, required string problem ){
		throw(
			type    = "RuleBox.InvalidRuleDefinitionException",
			message = "Invalid definition for rule #arguments.ruleLabel# at '#arguments.path#': #arguments.problem#",
			detail  = "Rule definitions are validated when loadRules() builds them. See the 'Externalized Rules' guide for the condition grammar."
		)
	}

}
