<bx:output>
<div x-data="rbLive( '#prc.vizLink( 'stream' )#' )" x-init="start()">
	<div class="d-flex align-items-center justify-content-between mb-4">
		<h1 class="h3 mb-0">Live Tracker</h1>
		<div class="d-flex align-items-center gap-2">
			<span class="badge" :class="connected ? 'text-bg-success' : 'text-bg-secondary'">
				<i class="ph ph-broadcast"></i> <span x-text="connected ? 'Live' : 'Connecting'"></span>
			</span>
			<span class="text-secondary small">Streaming via BoxLang SSE</span>
			<button class="btn btn-sm btn-outline-light" @click="paused ? resume() : pause()">
				<i class="ph" :class="paused ? 'ph-play' : 'ph-pause'"></i>
				<span x-text="paused ? 'Resume' : 'Pause'"></span>
			</button>
		</div>
	</div>

	<div class="card bg-body-tertiary">
		<div class="table-responsive" style="max-height: 70vh">
			<table class="table table-sm table-hover align-middle mb-0 font-monospace">
				<thead class="sticky-top bg-body-tertiary">
					<tr><th>Time</th><th>Rulebook</th><th>Rule</th><th>State</th><th>Duration</th></tr>
				</thead>
				<!--- One tbody per event: its row, then (FAILED only) its expandable error details --->
				<template x-for="(evt, i) in events" :key="i">
					<tbody class="border-top-0">
						<tr :class="evt.state === 'FAILED' && 'rb-row-failed'" :role="evt.errorType ? 'button' : null" @click="evt.errorType && ( evt.open = !evt.open )">
							<td class="text-nowrap" x-text="evt.timestamp"></td>
							<td x-text="evt.rulebookName"></td>
							<td>
								<span x-text="evt.ruleName"></span>
								<template x-if="evt.errorType">
									<div class="small text-truncate" style="max-width: 340px" :title="evt.errorType + ': ' + ( evt.errorMessage ?? '' )">
										<i class="ph" :class="evt.open ? 'ph-caret-up' : 'ph-caret-down'"></i>
										<span class="fw-medium rb-error-text" x-text="evt.errorType"></span>: <span x-text="evt.errorMessage"></span>
									</div>
								</template>
							</td>
							<td>
								<span class="badge border" :class="'rb-badge-' + evt.state" x-text="evt.state"></span>
							</td>
							<td class="text-nowrap" x-text="Number( evt.durationMs ).toFixed( 2 ) + 'ms'"></td>
						</tr>
						<tr x-show="evt.open" x-cloak>
							<td colspan="5" class="rb-errors-cell">
								<div class="rb-error-card">
									<div class="small mb-2" x-text="evt.errorMessage"></div>
									<template x-for="( cause, depth ) in ( evt.errorCausedBy ?? [] )" :key="depth">
										<div class="small rb-cause" :style="'margin-left:' + ( depth * 12 ) + 'px'">
											<span class="text-secondary">Caused by</span>
											<span class="fw-medium rb-error-text" x-text="cause.type"></span>:
											<span x-text="cause.message"></span>
										</div>
									</template>
									<pre class="rb-trace" x-show="( evt.errorStackTrace ?? [] ).length" x-text="( evt.errorStackTrace ?? [] ).map( ( frame ) => 'at ' + frame ).join( '\n' )"></pre>
									<details x-show="evt.errorRawStackTrace">
										<summary class="small text-secondary">Raw Java stack trace</summary>
										<pre class="rb-trace rb-trace-raw" x-text="evt.errorRawStackTrace"></pre>
									</details>
								</div>
							</td>
						</tr>
					</tbody>
				</template>
				<tbody x-show="!events.length">
					<tr>
						<td colspan="5" class="text-secondary text-center py-4">Waiting for rule evaluations&hellip; run a rulebook to see events here.</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</div>

<script>
	function rbLive( streamUrl ){
		return {
			events: [],
			connected: false,
			paused: false,
			source: null,
			maxRows: 200,
			start(){
				this.source = new EventSource( streamUrl )
				this.source.addEventListener( 'open', () => this.connected = true )
				this.source.addEventListener( 'error', () => this.connected = false )
				this.source.addEventListener( 'rule', ( e ) => {
					if( this.paused ) return
					const evt = JSON.parse( e.data )
					evt.open = false
					this.events.unshift( evt )
					if( this.events.length > this.maxRows ){
						this.events.length = this.maxRows
					}
				} )
			},
			pause(){ this.paused = true },
			resume(){ this.paused = false }
		}
	}
</script>
</bx:output>
