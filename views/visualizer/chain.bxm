<div class="d-flex align-items-center justify-content-between mb-4">
	<div>
		<h1 class="h3 mb-1">#prc.rulebookName#</h1>
		<span class="badge bg-primary">#prc.chain.len()# rules</span>
	</div>
	<div class="d-flex gap-2">
		<form method="get" class="d-flex gap-2">
			<select name="name" class="form-select form-select-sm" onchange="this.form.submit()">
				<bx:loop array="#prc.rulebookNames#" index="n">
					<option value="#n#" #( n == prc.rulebookName ? "selected" : "" )#>#n#</option>
				</bx:loop>
			</select>
		</form>
		<a class="btn btn-sm btn-primary" href="#event.buildLink( 'visualizer.dryrun' )#?name=#urlEncodedFormat( prc.rulebookName )#">
			<i class="ph ph-flask"></i> Dry Run
		</a>
	</div>
</div>

<div class="d-flex flex-column gap-2">
	<bx:loop array="#prc.chain#" index="node">
		<div class="card bg-body-tertiary">
			<div class="card-body d-flex align-items-start justify-content-between gap-3">
				<div>
					<div class="d-flex align-items-center gap-2 mb-1">
						<span class="badge text-bg-secondary">P#node.priority#</span>
						<span class="fw-medium">#node.name#</span>
						<bx:if node.stops>
							<span class="badge rb-badge-STOPPED border">stops chain</span>
						</bx:if>
						<bx:if len( node.activeFrom ) or len( node.activeUntil )>
							<span class="badge text-bg-dark">
								<i class="ph ph-clock"></i>
								active #len( node.activeFrom ) ? node.activeFrom : "always"# &rarr; #len( node.activeUntil ) ? node.activeUntil : "always"#
							</span>
						</bx:if>
					</div>
					<div class="text-secondary small">
						#numberFormat( node.metrics.totalEvaluations )# evaluations &middot;
						avg #numberFormat( node.metrics.avgDurationMs, "0.00" )#ms
					</div>
				</div>
				<div class="d-flex gap-1 flex-wrap" style="max-width: 360px">
					<bx:loop collection="#node.metrics.countsByState#" item="state">
						<span class="badge border rb-badge-#state#">#state#: #node.metrics.countsByState[ state ]#</span>
					</bx:loop>
				</div>
			</div>
		</div>
	</bx:loop>
	<bx:if prc.chain.isEmpty()>
		<div class="text-secondary">This rulebook has no rules.</div>
	</bx:if>
</div>
