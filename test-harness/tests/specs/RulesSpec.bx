/**
* My BDD Test
*/
class extends="tests.resources.BaseSpec"{

		function run( testResults, testBox ){
			// all your suites go here.
			describe( "A Rule", () => {

				beforeEach( currentSpec =>{
					variables.rulebook = getInstance( "rulebook@rulebox" );
				})

				it( "can be created", () =>{
					var rule = getInstance( "Rule@rulebox" )
						.setRuleBook( rulebook );
					expect( rule ).toBeclass();
					expect( rule.getFacts() ).toBeEmpty();
					expect( rule.getCurrentState() ).toBe( rule.STATES.NEXT );
					expect( rule.getConsumers() ).toBeEmpty();
					expect( isClosure( rule.getPredicate() ) ).toBeTrue();
				});

				it( "can store a given fact", () =>{
					var rule = getInstance( "rule@rulebox" )
						.given( "name", "luis" );
					expect( rule.getFacts() ).toHaveKey( "name" );
				});

				it( "can store multiple facts", () =>{
					var rule = getInstance( "rule@rulebox" )
						.givenAll( { "name" : "luis" } );
					expect( rule.getFacts() ).toHaveKey( "name" );
				});


				it( "can store when functions", () =>{
					var rule = getInstance( "rule@rulebox" )
						.when( function( facts ){
							return false;
						} );
					expect( isClosure( rule.getPredicate() ) ).toBeTrue();
					var predicate = rule.getPredicate();
					expect( predicate() ).toBeFalse();
				});

				it( "can store then functions", () =>{
					var rule = getInstance( "rule@rulebox" )
						.then( function( facts ){
						} );
					expect( rule.getConsumers().len() ).toBe( 1 );
				});

				it( "can store except functions", () =>{
					var rule = getInstance( "rule@rulebox" )
						.except( function( facts ){
							return false;
						} );
					expect( isClosure( rule.getExcept() ) ).toBeTrue();
					var except = rule.getExcept();
					expect( except() ).toBeFalse();
				});

				it( "can stop execution chains", () =>{
					var rule = getInstance( "rule@rulebox" )
						.stop();
					expect( rule.getCurrentState() ).toBe( rule.STATES.STOP );
				});

				it( "can store using fact names when none are defined", () =>{
					var rule = getInstance( "rule@rulebox" )
						.using( "name" )
						.using( "age" );
					expect( rule.getFactsNameMap()[ 1 ].findNoCase( "name" ) ).toBeTrue();
					expect( rule.getFactsNameMap()[ 1 ].findNoCase( "age" ) ).toBeTrue();
				});

				it( "can store the next rule", () =>{
					var rule = getInstance( "rule@rulebox" );

					expect( rule.getNextRule() ).toBeNull();

					rule
						.setNextRule(
							getInstance( "rule@rulebox" )
						);
					expect( rule.getNextRule() ).toBeclass();
				});

				it( "can run the rules when the predicate is false", () =>{
					var rule = getInstance( "rule@rulebox" )
						.setRuleBook( rulebook )
						.given( "name", "luis" )
						.when( function( facts ){
							return ( facts.keyExists( "age" ) );
						} )
						.run();
				});

				it( "can run the rules when the predicate is true", () =>{
					var ruleResult = false;
					var rule = getInstance( "rule@rulebox" )
						.setResult( getInstance( "Result@rulebox" ) )
						.setRuleBook( rulebook )
						.given( "name", "luis" )
						.when( facts => facts.keyExists( "name" ) )
						.then( ( facts, results ) => {
							ruleResult = true;
						} )
						.run();

					expect( ruleResult ).toBeTrue();
				});

			});
		}

	}
