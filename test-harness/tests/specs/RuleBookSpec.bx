/**
* My BDD Test
*/
class extends="tests.resources.BaseSpec"{

	function run( testResults, testBox ){
		// all your suites go here.
		describe( "A Rule Book", function(){

			it( "can be created", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" );
				expect( ruleBook ).toBeclass();
				expect( ruleBook.getFacts() ).toBeEmpty();
			});

			it( "can store a given fact", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" )
					.given( "name", "luis" );
				expect( ruleBook.getFacts() ).toHaveKey( "name" );
			});

			it( "can store multiple facts", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" )
					.givenAll( { "name" : "luis" } );
				expect( ruleBook.getFacts() ).toHaveKey( "name" );
			});

			it( "can create rules", function(){
				var rule = getInstance( "RuleBook@rulebox" ).newRule( "my-rule" );
				expect( rule ).toBeclass();
				expect( rule.getName() ).toBe( "my-rule" );
			});


			it( "can add a rule when no rules are defined", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" );
				var rule = ruleBook
					.newRule( "my-rule" );
				ruleBook.addRule( rule );

				expect( ruleBook.getHeadRule() ).toBe( rule );
				expect( ruleBook.getTailRule() ).toBe( rule );
			});

			it( "can add multiple rules", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" );
				var rule1 = ruleBook.newRule();
				var rule2 = ruleBook.newRule();

				ruleBook.addRule( rule1 ).addRule( rule2 );

				expect( ruleBook.getHeadRule() ).toBe( rule1 );
				expect( ruleBook.getTailRule() ).toBe( rule2 );
			});


			it( "executes rules in priority order regardless of insertion order", function(){
				var executionOrder = [];
				var ruleBook = getInstance( "RuleBook@rulebox" );

				var ruleA = ruleBook.newRule( "A" ).withPriority( 1 ).then( ( facts ) => { executionOrder.append( "A" ); } );
				var ruleB = ruleBook.newRule( "B" ).withPriority( 10 ).then( ( facts ) => { executionOrder.append( "B" ); } );
				var ruleC = ruleBook.newRule( "C" ).withPriority( 5 ).then( ( facts ) => { executionOrder.append( "C" ); } );

				// Added low-to-high insertion order, but priority should drive execution order
				ruleBook.addRule( ruleA ).addRule( ruleB ).addRule( ruleC );

				ruleBook.run();

				expect( executionOrder.len() ).toBe( 3 );
				expect( executionOrder[ 1 ] ).toBe( "B" );
				expect( executionOrder[ 2 ] ).toBe( "C" );
				expect( executionOrder[ 3 ] ).toBe( "A" );
			});

			it( "executes same-priority rules in the order they were added", function(){
				var executionOrder = [];
				var ruleBook = getInstance( "RuleBook@rulebox" );

				ruleBook.addRule( ruleBook.newRule( "A" ).then( ( facts ) => { executionOrder.append( "A" ); } ) );
				ruleBook.addRule( ruleBook.newRule( "B" ).then( ( facts ) => { executionOrder.append( "B" ); } ) );
				ruleBook.addRule( ruleBook.newRule( "C" ).then( ( facts ) => { executionOrder.append( "C" ); } ) );

				ruleBook.run();

				expect( executionOrder.len() ).toBe( 3 );
				expect( executionOrder[ 1 ] ).toBe( "A" );
				expect( executionOrder[ 2 ] ).toBe( "B" );
				expect( executionOrder[ 3 ] ).toBe( "C" );
			});

			it( "correctly reorders the chain when a higher priority rule is added after lower priority rules", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" );
				var ruleA = ruleBook.newRule( "A" );
				var ruleB = ruleBook.newRule( "B" );
				var ruleC = ruleBook.newRule( "C" ).withPriority( 100 );

				// A -> B is already linked before the higher priority C is added
				ruleBook.addRule( ruleA ).addRule( ruleB );
				ruleBook.addRule( ruleC );

				expect( ruleBook.getHeadRule() ).toBe( ruleC );
				expect( ruleC.getNextRule() ).toBe( ruleA );
				expect( ruleA.getNextRule() ).toBe( ruleB );
				expect( ruleBook.getTailRule() ).toBe( ruleB );
			});

			it( "can detect set rules", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" );
				expect( ruleBook.hasRules() ).toBeFalse();
				ruleBook.addRule( ruleBook.newRule() );
				expect( ruleBook.hasRules() ).toBeTrue();
			});


			it( "can ignore running rules if none are set", function(){
				var ruleBook = prepareMock( getInstance( "RuleBook@rulebox" ) )
					.$( "defineRules" )
					.$( "hasRules", false );
				ruleBook.run();
				expect( ruleBook.$once( "defineRules") ).toBeTrue();
				expect( ruleBook.$times( 2, "hasRules") ).toBeTrue();
			});

			it( "can run rules", function(){
				var ruleBook = prepareMock( getInstance( "RuleBook@rulebox" ) );
				var mockRule = prepareMock( rulebook.newRule() )
					.$( "run" );

				ruleBook
					.givenAll( { name: "luis" } )
						.addRule( mockRule )
					.run();

				expect( mockRule.$once( "run" ) ).toBeTrue();
			});

			it( "can be run again with the same facts and produce the same outcome", function(){
				var runCount = 0;
				var ruleBook = getInstance( "RuleBook@rulebox" )
					.given( "name", "luis" );
				ruleBook.addRule(
					ruleBook.newRule()
						.when( ( facts ) => facts.name == "luis" )
						.then( ( facts ) => {
							runCount++;
						} )
				);

				ruleBook.run();
				ruleBook.run();

				expect( runCount ).toBe( 2 );
			});

			it( "resets the rule status audit trail on each run so it never shows stale state from a previous run", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" );
				var rule1 = ruleBook.newRule( "maybeStop" )
					.when( ( facts ) => facts.stop )
					.then( ( facts ) => {} )
					.stop();
				var rule2 = ruleBook.newRule( "second" )
					.then( ( facts ) => {} );

				ruleBook.addRule( rule1 ).addRule( rule2 );

				// First run: rule1's condition is false, so it does not stop the chain and rule2 executes
				ruleBook.run( { "stop" : false } );
				expect( ruleBook.getRuleStatus( "second" ) ).toBe( ruleBook.RULE_STATES.EXECUTED );

				// Second run: rule1's condition is true, so it stops the chain and rule2 is never reached
				ruleBook.run( { "stop" : true } );
				expect( ruleBook.getRuleStatus( "second" ) ).toBe( ruleBook.RULE_STATES.REGISTERED );
			});

			it( "can dry-run and preview which rules would fire without invoking then()", function(){
				var consumerRan = false;
				var ruleBook = getInstance( "RuleBook@rulebox" );

				ruleBook.addRule(
					ruleBook.newRule( "matches" )
						.when( ( facts ) => facts.name == "luis" )
						.then( ( facts ) => { consumerRan = true; } )
				);
				ruleBook.addRule(
					ruleBook.newRule( "doesNotMatch" )
						.when( ( facts ) => facts.name == "someone-else" )
						.then( ( facts ) => { consumerRan = true; } )
				);

				var report = ruleBook.dryRun( { "name" : "luis" } );

				expect( report.len() ).toBe( 2 );
				expect( report[ 1 ].name ).toBe( "matches" );
				expect( report[ 1 ].wouldExecute ).toBeTrue();
				expect( report[ 2 ].name ).toBe( "doesNotMatch" );
				expect( report[ 2 ].wouldExecute ).toBeFalse();
				expect( consumerRan ).toBeFalse();
			});

			it( "dry-run stops walking at the first rule that would stop the chain", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" );

				ruleBook.addRule( ruleBook.newRule( "first" ).stop() );
				ruleBook.addRule( ruleBook.newRule( "neverReached" ) );

				var report = ruleBook.dryRun();

				expect( report.len() ).toBe( 1 );
				expect( report[ 1 ].name ).toBe( "first" );
				expect( report[ 1 ].wouldStop ).toBeTrue();
			});

			it( "dry-run does not mutate facts, result, or the real audit trail", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" )
					.given( "name", "luis" );
				ruleBook.addRule( ruleBook.newRule( "someRule" ) );

				ruleBook.dryRun( { "age" : 40 } );

				expect( ruleBook.getFacts() ).notToHaveKey( "age" );
				expect( ruleBook.getResult().isPresent() ).toBeFalse();
				expect( ruleBook.getRuleStatus( "someRule" ) ).toBe( ruleBook.RULE_STATES.REGISTERED );
			});

			it( "dry-run returns an empty report when there are no rules", function(){
				var ruleBook = getInstance( "RuleBook@rulebox" );
				expect( ruleBook.dryRun() ).toBeEmpty();
			});

			it( "records a FAILED status and rethrows when a then() consumer throws", function(){
				var downstreamRan = false;
				var ruleBook = getInstance( "RuleBook@rulebox" );
				var badRule = ruleBook.newRule( "boom" )
					.then( ( facts ) => {
						throw( type = "TestBoom", message = "Kaboom" );
					} );
				var nextRule = ruleBook.newRule( "afterBoom" )
					.then( ( facts ) => {
						downstreamRan = true;
					} );

				ruleBook.addRule( badRule ).addRule( nextRule );

				expect( function(){
					ruleBook.run();
				} ).toThrow();

				expect( ruleBook.getRuleStatus( "boom" ) ).toBe( ruleBook.RULE_STATES.FAILED );
				expect( downstreamRan ).toBeFalse();
			});

		});
	}

}
