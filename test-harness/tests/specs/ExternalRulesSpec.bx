/**
* Tests for externalized rule definitions: registerAction()/registerPredicate() and loadRules()
* against JSONRuleSource, YAMLRuleSource, and DBRuleSource.
*/
class extends="tests.resources.BaseSpec"{

	/**
	 * Load a single rule definition and return the exception it throws, failing the test if it loads fine.
	 */
	private any function loadAndCatch( required struct def, any ruleBook ){
		var target = isNull( arguments.ruleBook ) ? getInstance( "RuleBook@rulebox" ) : arguments.ruleBook
		try{
			target.loadRules( new tests.resources.InlineRuleSource( [ arguments.def ] ) )
		} catch( any e ){
			return e
		}
		fail( "Expected loadRules() to throw for: #jsonSerialize( arguments.def )#" )
	}

	function run( testResults, testBox ){
		describe( "Externalized Rule Definitions", function(){

			describe( "registerAction()", function(){

				it( "accepts a closure", function(){
					var ran = false;
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flag", ( facts, result, params ) => { ran = true; } );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{ "name" : "r1", "then" : [ { "action" : "flag" } ] }
					] ) );
					ruleBook.run();

					expect( ran ).toBeTrue();
				} );

				it( "accepts an object instance with an execute() method", function(){
					var action = new tests.resources.StubRuleAction();
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flag", action );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{ "name" : "r1", "then" : [ { "action" : "flag", "params" : { "x" : 1 } } ] }
					] ) );
					ruleBook.run();

					expect( action.getCallCount() ).toBe( 1 );
					expect( action.getLastParams() ).toBe( { "x" : 1 } );
				} );

				it( "accepts a WireBox mapping ID string, resolved eagerly at registration", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flag", "StubWireboxAction" );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{ "name" : "r1", "then" : [ { "action" : "flag" } ] }
					] ) );
					ruleBook.run();

					// It was truly resolved via WireBox into a real StubWireboxAction whose execute() ran
					expect( ruleBook.getActionRegistry()[ "flag" ].getCallCount() ).toBe( 1 );
				} );

			} );

			describe( "registerPredicate()", function(){

				it( "accepts a closure", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerPredicate( "isEligible", ( facts, params ) => facts.creditScore >= params.threshold );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{
							"name" : "r1",
							"when" : { "predicate" : "isEligible", "params" : { "threshold" : 600 } },
							"then" : []
						}
					] ) );

					var report = ruleBook.dryRun( { "creditScore" : 650 } );
					expect( report[ 1 ].wouldExecute ).toBeTrue();
				} );

				it( "accepts an object instance with a test() method", function(){
					var predicate = new tests.resources.StubRulePredicate();
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerPredicate( "isEligible", predicate );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{
							"name" : "r1",
							"when" : { "predicate" : "isEligible", "params" : { "threshold" : 600 } },
							"then" : []
						}
					] ) );

					ruleBook.dryRun( { "creditScore" : 650 } );
					expect( predicate.getCallCount() ).toBe( 1 );
				} );

				it( "accepts a WireBox mapping ID string, resolved eagerly at registration", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerPredicate( "isEligible", "StubWireboxAction" );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{
							"name" : "r1",
							"when" : { "predicate" : "isEligible", "params" : { "threshold" : 600 } },
							"then" : []
						}
					] ) );
					ruleBook.dryRun( { "creditScore" : 650 } );

					// It was truly resolved via WireBox into a real StubWireboxAction whose test() ran
					expect( ruleBook.getPredicateRegistry()[ "isEligible" ].getCallCount() ).toBe( 1 );
				} );

			} );

			describe( "loadRules()", function(){

				it( "throws when a `then` action references an unregistered name", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" );

					expect( function(){
						ruleBook.loadRules( new tests.resources.InlineRuleSource( [
							{ "name" : "r1", "then" : [ { "action" : "doesNotExist" } ] }
						] ) );
					} ).toThrow( "RuleBox.UnregisteredActionException" );
				} );

				it( "throws when a `when` predicate references an unregistered name", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" );

					expect( function(){
						ruleBook.loadRules( new tests.resources.InlineRuleSource( [
							{ "name" : "r1", "when" : { "predicate" : "doesNotExist" }, "then" : [] }
						] ) );
					} ).toThrow( "RuleBox.UnregisteredPredicateException" );
				} );

				it( "re-applies `using` before every then() action in the same rule", function(){
					var seenFacts = [];
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "capture", ( facts, result, params ) => { seenFacts.append( facts ); } )
						.given( "name", "luis" )
						.given( "age", 40 );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{
							"name" : "r1",
							"using" : [ "name" ],
							"then" : [ { "action" : "capture" }, { "action" : "capture" } ]
						}
					] ) );
					ruleBook.run();

					expect( seenFacts.len() ).toBe( 2 );
					expect( seenFacts[ 1 ] ).toHaveKey( "name" );
					expect( seenFacts[ 1 ] ).notToHaveKey( "age" );
					expect( seenFacts[ 2 ] ).toHaveKey( "name" );
					expect( seenFacts[ 2 ] ).notToHaveKey( "age" );
				} );

				it( "applies priority, stop, and the condition-tree grammar end-to-end from JSONRuleSource", function(){
					var results = [];
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flagHighRisk", ( facts, result, params ) => { results.append( "highRisk" ); } )
						.registerAction( "approveApplicant", ( facts, result, params ) => { results.append( "approved:" & params.reason ); } );

					ruleBook.loadRules( getInstance(
						"JSONRuleSource@rulebox",
						{ filePath : expandPath( "/tests/resources/rules/credit-rules.json" ) }
					) );

					ruleBook.run( { "creditScore" : 550 } );
					expect( results ).toBe( [ "highRisk" ] );

					results = [];
					ruleBook.run( { "creditScore" : 700 } );
					expect( results ).toBe( [ "approved:good credit" ] );
				} );

				it( "applies the same grammar end-to-end from YAMLRuleSource, when the optional YAML module is installed", function(){
					var results = [];
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flagHighRisk", ( facts, result, params ) => { results.append( "highRisk" ); } )
						.registerAction( "approveApplicant", ( facts, result, params ) => { results.append( "approved:" & params.reason ); } );

					try{
						ruleBook.loadRules( getInstance(
							"YAMLRuleSource@rulebox",
							{ filePath : expandPath( "/tests/resources/rules/credit-rules.yaml" ) }
						) );
					} catch( any e ){
						skip( "boxlang-yaml module is not installed: #e.message#" );
						return;
					}

					ruleBook.run( { "creditScore" : 550 } );
					expect( results ).toBe( [ "highRisk" ] );
				} );

				it( "applies the same grammar end-to-end from DBRuleSource given a pre-built query", function(){
					var results = [];
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flagHighRisk", ( facts, result, params ) => { results.append( "highRisk" ); } )
						.registerAction( "approveApplicant", ( facts, result, params ) => { results.append( "approved:" & params.reason ); } );

					var rows = queryNew( "name,priority,when_json,then_json,stop", "varchar,integer,varchar,varchar,bit" );
					queryAddRow( rows, [
						{
							"name"      : "highRisk",
							"priority"  : 10,
							"when_json" : jsonSerialize( { "lt" : [ "creditScore", 600 ] } ),
							"then_json" : jsonSerialize( [ { "action" : "flagHighRisk" } ] ),
							"stop"      : true
						},
						{
							"name"      : "approve",
							"priority"  : 0,
							"when_json" : jsonSerialize( { "gte" : [ "creditScore", 600 ] } ),
							"then_json" : jsonSerialize( [ { "action" : "approveApplicant", "params" : { "reason" : "good credit" } } ] ),
							"stop"      : false
						}
					] );

					ruleBook.loadRules( getInstance( "DBRuleSource@rulebox", { query : rows } ) );

					ruleBook.run( { "creditScore" : 550 } );
					expect( results ).toBe( [ "highRisk" ] );

					results = [];
					ruleBook.run( { "creditScore" : 700 } );
					expect( results ).toBe( [ "approved:good credit" ] );
				} );

			} );

			describe( "loadRules() load-time validation", function(){

				it( "rejects an unknown operator, naming the rule and path", function(){
					var e = loadAndCatch( { "name" : "badOp", "when" : { "like" : [ "name", "a%" ] } } );
					expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
					expect( e.message ).toInclude( "'badOp'" );
					expect( e.message ).toInclude( "when.like" );
					expect( e.message ).toInclude( "unknown condition operator" );
				} );

				it( "rejects comparison operands that are not a 2-element array", function(){
					for( var operand in [ "a", [ "a" ], [ "a", 1, 2 ], {}, 5 ] ){
						var e = loadAndCatch( { "name" : "badShape", "when" : { "eq" : operand } } );
						expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
						expect( e.message ).toInclude( "'badShape'" );
						expect( e.message ).toInclude( "when.eq" );
						expect( e.message ).toInclude( "2-element array" );
					}
				} );

				it( "rejects every comparison operator with a bad shape", function(){
					for( var op in [ "eq", "neq", "lt", "lte", "gt", "gte", "in" ] ){
						var e = loadAndCatch( { "name" : "r", "when" : { "#op#" : [ "only-one" ] } } );
						expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
						expect( e.message ).toInclude( "when.#op#" );
					}
				} );

				it( "rejects a comparison whose first operand is not a fact path", function(){
					var e = loadAndCatch( { "name" : "badPath", "when" : { "lt" : [ {}, 10 ] } } );
					expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
					expect( e.message ).toInclude( "when.lt[1]" );
					expect( e.message ).toInclude( "fact path" );
				} );

				it( "rejects `in` when the second operand is not an array", function(){
					var e = loadAndCatch( { "name" : "badIn", "when" : { "in" : [ "a", "notAnArray" ] } } );
					expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
					expect( e.message ).toInclude( "'badIn'" );
					expect( e.message ).toInclude( "when.in[2]" );
					expect( e.message ).toInclude( "array" );
				} );

				it( "rejects `not` given an array instead of a single node", function(){
					var e = loadAndCatch( { "name" : "badNot", "when" : { "not" : [ { "eq" : [ "a", 1 ] } ] } } );
					expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
					expect( e.message ).toInclude( "'badNot'" );
					expect( e.message ).toInclude( "when.not" );
					expect( e.message ).toInclude( "single condition node" );
				} );

				it( "rejects and/or given an empty or non-array operand", function(){
					for( var op in [ "and", "or" ] ){
						for( var operand in [ [], "x", { "eq" : [ "a", 1 ] } ] ){
							var e = loadAndCatch( { "name" : "badLogic", "when" : { "#op#" : operand } } );
							expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
							expect( e.message ).toInclude( "when.#op#" );
							expect( e.message ).toInclude( "non-empty array" );
						}
					}
				} );

				it( "rejects a node with more than one operator key", function(){
					var e = loadAndCatch( { "name" : "multi", "when" : { "eq" : [ "a", 1 ], "lt" : [ "b", 2 ] } } );
					expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
					expect( e.message ).toInclude( "'multi'" );
					expect( e.message ).toInclude( "2 operator keys" );
				} );

				it( "rejects an empty condition struct", function(){
					var e = loadAndCatch( { "name" : "empty", "when" : {} } );
					expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
					expect( e.message ).toInclude( "empty struct" );
				} );

				it( "finds a bad branch even when it sits behind short-circuiting and/or", function(){
					// The first branch is false for the facts below, so run() would never reach the bad one
					var e = loadAndCatch( {
						"name" : "deep",
						"when" : { "and" : [
							{ "eq" : [ "a", 1 ] },
							{ "or" : [ { "eq" : [ "b", 2 ] }, { "lt" : [ "c" ] } ] }
						] }
					} );
					expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
					expect( e.message ).toInclude( "'deep'" );
					expect( e.message ).toInclude( "when.and[2].or[2].lt" );
				} );

				it( "validates the `except` tree too, with an except. path", function(){
					var e = loadAndCatch( { "name" : "exc", "when" : { "eq" : [ "a", 1 ] }, "except" : { "not" : "oops" } } );
					expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
					expect( e.message ).toInclude( "except.not" );
				} );

				it( "rejects unparseable activeFrom and activeUntil values", function(){
					for( var key in [ "activeFrom", "activeUntil" ] ){
						var e = loadAndCatch( { "name" : "badDate", "#key#" : "not a date" } );
						expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
						expect( e.message ).toInclude( "'badDate'" );
						expect( e.message ).toInclude( "'#key#'" );
						expect( e.message ).toInclude( "not a date" );
					}
				} );

				it( "accepts valid ISO date strings and date objects", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" );
					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{ "name" : "iso", "activeFrom" : "2026-01-01T00:00:00", "activeUntil" : "2099-01-01T00:00:00" },
						{ "name" : "obj", "activeFrom" : now(), "activeUntil" : dateAdd( "d", 1, now() ) }
					] ) );
					expect( ruleBook.getRules() ).toHaveLength( 2 );
				} );

				it( "gives a clear message for a predicate reference nested inside and/or/not", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerPredicate( "isEligible", ( facts, params ) => true );

					var e = loadAndCatch(
						{ "name" : "nestedPred", "when" : { "and" : [ { "predicate" : "isEligible" } ] } },
						ruleBook
					);
					expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
					expect( e.message ).toInclude( "'nestedPred'" );
					expect( e.message ).toInclude( "when.and[1].predicate" );
					expect( e.message ).toInclude( "predicate references are only supported at the top level of when/except" );
					expect( e.type ).notToBe( "RuleBox.UnknownConditionOperatorException" );

					e = loadAndCatch(
						{ "name" : "nestedPred2", "when" : { "not" : { "predicate" : "isEligible", "params" : {} } } },
						ruleBook
					);
					expect( e.message ).toInclude( "only supported at the top level" );
				} );

				it( "still accepts a top-level predicate reference in when and except", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerPredicate( "yes", ( facts, params ) => true )
						.registerPredicate( "no", ( facts, params ) => false );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{ "name" : "r1", "when" : { "predicate" : "yes" }, "except" : { "predicate" : "no", "params" : { "x" : 1 } }, "then" : [] }
					] ) );

					expect( ruleBook.dryRun( {} )[ 1 ].wouldExecute ).toBeTrue();
				} );

				it( "identifies an unnamed rule by its 1-based position in the source", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" );
					var e = {};
					try{
						ruleBook.loadRules( new tests.resources.InlineRuleSource( [
							{ "name" : "fine", "when" : { "eq" : [ "a", 1 ] } },
							{ "when" : { "eq" : [ "a", 1 ] } },
							{ "when" : { "gt" : "a" } }
						] ) );
					} catch( any ex ){
						e = ex;
					}
					expect( e ).toHaveKey( "type" );
					expect( e.type ).toBe( "RuleBox.InvalidRuleDefinitionException" );
					expect( e.message ).toInclude( "##3 (unnamed)" );
					expect( e.message ).toInclude( "when.gt" );
				} );

				it( "leaves the book unchanged when any definition in the source is invalid", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" );

					expect( function(){
						ruleBook.loadRules( new tests.resources.InlineRuleSource( [
							{ "name" : "good", "when" : { "eq" : [ "a", 1 ] } },
							{ "name" : "bad", "when" : { "eq" : [ "a" ] } }
						] ) );
					} ).toThrow( "RuleBox.InvalidRuleDefinitionException" );

					expect( ruleBook.getRules() ).toBeEmpty();
				} );

				it( "accepts every valid shape of the grammar", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" );
					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{
							"name" : "everything",
							"when" : { "and" : [
								{ "eq" : [ "a.b", 1 ] },
								{ "neq" : [ "c", "x" ] },
								{ "or" : [ { "lt" : [ "d", 5 ] }, { "lte" : [ "d", 5 ] }, { "gt" : [ "e", 0 ] }, { "gte" : [ "e", 0 ] } ] },
								{ "not" : { "in" : [ "f", [ 1, 2, 3 ] ] } }
							] },
							"except" : { "eq" : [ "g", "stop" ] }
						}
					] ) );
					expect( ruleBook.getRules() ).toHaveLength( 1 );
				} );

			} );

		} );
	}

}
