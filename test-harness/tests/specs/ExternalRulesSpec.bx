/**
* Tests for externalized rule definitions: registerAction()/registerPredicate() and loadRules()
* against JSONRuleSource, YAMLRuleSource, and DBRuleSource.
*/
class extends="tests.resources.BaseSpec"{

	function run( testResults, testBox ){
		describe( "Externalized Rule Definitions", function(){

			describe( "registerAction()", function(){

				it( "accepts a closure", function(){
					var ran = false;
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flag", ( facts, result, params ) => { ran = true; } );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{ "name" : "r1", "then" : [ { "action" : "flag" } ] }
					] ) );
					ruleBook.run();

					expect( ran ).toBeTrue();
				} );

				it( "accepts an object instance with an execute() method", function(){
					var action = new tests.resources.StubRuleAction();
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flag", action );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{ "name" : "r1", "then" : [ { "action" : "flag", "params" : { "x" : 1 } } ] }
					] ) );
					ruleBook.run();

					expect( action.getCallCount() ).toBe( 1 );
					expect( action.getLastParams() ).toBe( { "x" : 1 } );
				} );

				it( "accepts a WireBox mapping ID string, resolved eagerly at registration", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flag", "StubWireboxAction" );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{ "name" : "r1", "then" : [ { "action" : "flag" } ] }
					] ) );
					ruleBook.run();

					// It was truly resolved via WireBox into a real StubWireboxAction whose execute() ran
					expect( ruleBook.getActionRegistry()[ "flag" ].getCallCount() ).toBe( 1 );
				} );

			} );

			describe( "registerPredicate()", function(){

				it( "accepts a closure", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerPredicate( "isEligible", ( facts, params ) => facts.creditScore >= params.threshold );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{
							"name" : "r1",
							"when" : { "predicate" : "isEligible", "params" : { "threshold" : 600 } },
							"then" : []
						}
					] ) );

					var report = ruleBook.dryRun( { "creditScore" : 650 } );
					expect( report[ 1 ].wouldExecute ).toBeTrue();
				} );

				it( "accepts an object instance with a test() method", function(){
					var predicate = new tests.resources.StubRulePredicate();
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerPredicate( "isEligible", predicate );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{
							"name" : "r1",
							"when" : { "predicate" : "isEligible", "params" : { "threshold" : 600 } },
							"then" : []
						}
					] ) );

					ruleBook.dryRun( { "creditScore" : 650 } );
					expect( predicate.getCallCount() ).toBe( 1 );
				} );

				it( "accepts a WireBox mapping ID string, resolved eagerly at registration", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerPredicate( "isEligible", "StubWireboxAction" );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{
							"name" : "r1",
							"when" : { "predicate" : "isEligible", "params" : { "threshold" : 600 } },
							"then" : []
						}
					] ) );
					ruleBook.dryRun( { "creditScore" : 650 } );

					// It was truly resolved via WireBox into a real StubWireboxAction whose test() ran
					expect( ruleBook.getPredicateRegistry()[ "isEligible" ].getCallCount() ).toBe( 1 );
				} );

			} );

			describe( "loadRules()", function(){

				it( "throws when a `then` action references an unregistered name", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" );

					expect( function(){
						ruleBook.loadRules( new tests.resources.InlineRuleSource( [
							{ "name" : "r1", "then" : [ { "action" : "doesNotExist" } ] }
						] ) );
					} ).toThrow( "RuleBox.UnregisteredActionException" );
				} );

				it( "throws when a `when` predicate references an unregistered name", function(){
					var ruleBook = getInstance( "RuleBook@rulebox" );

					expect( function(){
						ruleBook.loadRules( new tests.resources.InlineRuleSource( [
							{ "name" : "r1", "when" : { "predicate" : "doesNotExist" }, "then" : [] }
						] ) );
					} ).toThrow( "RuleBox.UnregisteredPredicateException" );
				} );

				it( "re-applies `using` before every then() action in the same rule", function(){
					var seenFacts = [];
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "capture", ( facts, result, params ) => { seenFacts.append( facts ); } )
						.given( "name", "luis" )
						.given( "age", 40 );

					ruleBook.loadRules( new tests.resources.InlineRuleSource( [
						{
							"name" : "r1",
							"using" : [ "name" ],
							"then" : [ { "action" : "capture" }, { "action" : "capture" } ]
						}
					] ) );
					ruleBook.run();

					expect( seenFacts.len() ).toBe( 2 );
					expect( seenFacts[ 1 ] ).toHaveKey( "name" );
					expect( seenFacts[ 1 ] ).notToHaveKey( "age" );
					expect( seenFacts[ 2 ] ).toHaveKey( "name" );
					expect( seenFacts[ 2 ] ).notToHaveKey( "age" );
				} );

				it( "applies priority, stop, and the condition-tree grammar end-to-end from JSONRuleSource", function(){
					var results = [];
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flagHighRisk", ( facts, result, params ) => { results.append( "highRisk" ); } )
						.registerAction( "approveApplicant", ( facts, result, params ) => { results.append( "approved:" & params.reason ); } );

					ruleBook.loadRules( getInstance(
						"JSONRuleSource@rulebox",
						{ filePath : expandPath( "/tests/resources/rules/credit-rules.json" ) }
					) );

					ruleBook.run( { "creditScore" : 550 } );
					expect( results ).toBe( [ "highRisk" ] );

					results = [];
					ruleBook.run( { "creditScore" : 700 } );
					expect( results ).toBe( [ "approved:good credit" ] );
				} );

				it( "applies the same grammar end-to-end from YAMLRuleSource, when the optional YAML module is installed", function(){
					var results = [];
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flagHighRisk", ( facts, result, params ) => { results.append( "highRisk" ); } )
						.registerAction( "approveApplicant", ( facts, result, params ) => { results.append( "approved:" & params.reason ); } );

					try{
						ruleBook.loadRules( getInstance(
							"YAMLRuleSource@rulebox",
							{ filePath : expandPath( "/tests/resources/rules/credit-rules.yaml" ) }
						) );
					} catch( any e ){
						skip( "boxlang-yaml module is not installed: #e.message#" );
						return;
					}

					ruleBook.run( { "creditScore" : 550 } );
					expect( results ).toBe( [ "highRisk" ] );
				} );

				it( "applies the same grammar end-to-end from DBRuleSource given a pre-built query", function(){
					var results = [];
					var ruleBook = getInstance( "RuleBook@rulebox" )
						.registerAction( "flagHighRisk", ( facts, result, params ) => { results.append( "highRisk" ); } )
						.registerAction( "approveApplicant", ( facts, result, params ) => { results.append( "approved:" & params.reason ); } );

					var rows = queryNew( "name,priority,when_json,then_json,stop", "varchar,integer,varchar,varchar,bit" );
					queryAddRow( rows, [
						{
							"name"      : "highRisk",
							"priority"  : 10,
							"when_json" : jsonSerialize( { "lt" : [ "creditScore", 600 ] } ),
							"then_json" : jsonSerialize( [ { "action" : "flagHighRisk" } ] ),
							"stop"      : true
						},
						{
							"name"      : "approve",
							"priority"  : 0,
							"when_json" : jsonSerialize( { "gte" : [ "creditScore", 600 ] } ),
							"then_json" : jsonSerialize( [ { "action" : "approveApplicant", "params" : { "reason" : "good credit" } } ] ),
							"stop"      : false
						}
					] );

					ruleBook.loadRules( getInstance( "DBRuleSource@rulebox", { query : rows } ) );

					ruleBook.run( { "creditScore" : 550 } );
					expect( results ).toBe( [ "highRisk" ] );

					results = [];
					ruleBook.run( { "creditScore" : 700 } );
					expect( results ).toBe( [ "approved:good credit" ] );
				} );

			} );

			describe( "DBRuleSource row mapping", function(){

				// Builds a one-row, all-varchar query (as a loosely-typed legacy table would return), with overrides
				var buildRows = function( struct overrides = {} ){
					var row = {
						"name"        : "r1",
						"priority"    : "5",
						"active_from" : "",
						"when_json"   : '{ "eq" : [ "a", 1 ] }',
						"except_json" : "",
						"then_json"   : "[]",
						"stop"        : "false"
					};
					row.append( overrides );
					var rows = queryNew( "name,priority,active_from,when_json,except_json,then_json,stop" );
					queryAddRow( rows, [ row ] );
					return rows;
				};

				var loadFrom = function( required query rows ){
					return getInstance( "DBRuleSource@rulebox", { query : rows } ).load();
				};

				// Returns the type/message/detail of whatever loading throws (all empty when nothing is thrown)
				var captureError = function( required query rows ){
					var caught = { "type" : "", "message" : "", "detail" : "" };
					try {
						loadFrom( rows );
					} catch( any e ){
						caught = { "type" : e.type, "message" : e.message, "detail" : e.detail };
					}
					return caught;
				};

				it( "parses lenient `stop` values (true/false, 1/0, yes/no, y/n, empty; case-insensitive)", function(){
					[ "true", "TRUE", "1", "yes", "Yes", "y", "Y", " y " ].each( function( value ){
						expect( loadFrom( buildRows( { "stop" : value } ) )[ 1 ].stop ).toBeTrue( "stop [#value#]" );
					} );
					[ "false", "False", "0", "no", "NO", "n", "N", "", "  " ].each( function( value ){
						expect( loadFrom( buildRows( { "stop" : value } ) )[ 1 ].stop ).toBeFalse( "stop [#value#]" );
					} );
				} );

				it( "still accepts a real boolean `stop` column", function(){
					var rows = queryNew( "name,stop", "varchar,bit" );
					queryAddRow( rows, [ { "name" : "yes", "stop" : true }, { "name" : "no", "stop" : false } ] );

					var defs = loadFrom( rows );
					expect( defs[ 1 ].stop ).toBeTrue();
					expect( defs[ 2 ].stop ).toBeFalse();
				} );

				it( "throws RuleBox.InvalidRuleRowException naming the rule and column for a non-boolean `stop`", function(){
					var caught = captureError( buildRows( { "name" : "creditCheck", "stop" : "maybe" } ) );

					expect( caught.type ).toBe( "RuleBox.InvalidRuleRowException" );
					expect( caught.message ).toInclude( "creditCheck" );
					expect( caught.message ).toInclude( "stop" );
					expect( caught.message ).toInclude( "maybe" );
				} );

				it( "names the 1-based row number when the rule has no name", function(){
					var rows = buildRows();
					queryAddRow( rows, { "name" : "", "priority" : "1", "when_json" : "", "then_json" : "", "stop" : "bogus" } );

					var caught = captureError( rows );

					expect( caught.type ).toBe( "RuleBox.InvalidRuleRowException" );
					expect( caught.message ).toInclude( "row 2" );
				} );

				it( "throws RuleBox.InvalidRuleRowException naming the rule and column for invalid JSON in when_json, except_json and then_json", function(){
					[ "when_json", "except_json", "then_json" ].each( function( column ){
						var caught = captureError( buildRows( { "name" : "brokenRule", "#column#" : "{ not json" } ) );

						expect( caught.type ).toBe( "RuleBox.InvalidRuleRowException" );
						expect( caught.message ).toInclude( "brokenRule" );
						expect( caught.message ).toInclude( column );
						// the original parser error is preserved as the detail
						expect( caught.detail ).notToBeEmpty();
					} );
				} );

				it( "throws RuleBox.InvalidRuleRowException for an unparseable priority or date", function(){
					expect( function(){
						loadFrom( buildRows( { "name" : "badPriority", "priority" : "high" } ) );
					} ).toThrow( "RuleBox.InvalidRuleRowException", "badPriority" );

					expect( function(){
						loadFrom( buildRows( { "name" : "badFrom", "active_from" : "not a date" } ) );
					} ).toThrow( "RuleBox.InvalidRuleRowException", "active_from" );
				} );

				it( "still maps valid values, including dates and JSON columns", function(){
					var defs = loadFrom( buildRows( { "priority" : "7", "active_from" : "2026-01-01", "except_json" : '{ "eq" : [ "b", 2 ] }' } ) );

					expect( defs ).toHaveLength( 1 );
					expect( val( defs[ 1 ].priority ) ).toBe( 7 );
					expect( defs[ 1 ].activeFrom ).toBe( "2026-01-01" );
					expect( defs[ 1 ].when ).toBe( { "eq" : [ "a", 1 ] } );
					expect( defs[ 1 ].except ).toBe( { "eq" : [ "b", 2 ] } );
					expect( defs[ 1 ].then ).toBe( [] );
				} );

				it( "treats NULL optional columns as absent", function(){
					var rows = queryNew(
						"name,priority,active_from,active_until,when_json,except_json,then_json,stop,using_facts",
						"varchar,integer,timestamp,timestamp,varchar,varchar,varchar,bit,varchar"
					);
					queryAddRow( rows, 1 );
					querySetCell( rows, "name", "allNulls", 1 );

					var defs = loadFrom( rows );
					expect( defs ).toHaveLength( 1 );
					expect( defs[ 1 ].name ).toBe( "allNulls" );
					expect( defs[ 1 ].priority ).toBe( 0 );
					expect( defs[ 1 ].stop ).toBeFalse();
					expect( defs[ 1 ] ).notToHaveKey( "activeFrom" );
					expect( defs[ 1 ] ).notToHaveKey( "except" );
				} );

			} );

		} );
	}

}
