<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>RuleBox Visualizer</title>
	<!--- The RuleBox mark (docs/assets/brand/rulebox-mark.svg), inline so the Visualizer needs no asset route: the sidebar brand and the favicon --->
	<bx:savecontent variable="brandMark" trim="true">
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="16 18 386 330">
			<defs>
				<linearGradient id="rb-mark" gradientUnits="userSpaceOnUse" x1="60" y1="40" x2="430" y2="320">
					<stop offset="0" stop-color="#18F0AE"/>
					<stop offset="0.5" stop-color="#0FCFEA"/>
					<stop offset="1" stop-color="#1B78FF"/>
				</linearGradient>
				<linearGradient id="rb-shade-l" gradientUnits="userSpaceOnUse" x1="98" y1="0" x2="134" y2="0">
					<stop offset="0" stop-color="#000" stop-opacity="0"/>
					<stop offset="1" stop-color="#000" stop-opacity=".22"/>
				</linearGradient>
				<linearGradient id="rb-shade-r" gradientUnits="userSpaceOnUse" x1="343" y1="0" x2="378" y2="0">
					<stop offset="0" stop-color="#fff" stop-opacity=".10"/>
					<stop offset="1" stop-color="#000" stop-opacity=".10"/>
				</linearGradient>
			</defs>
			<g fill="url(#rb-mark)" stroke="url(#rb-mark)" stroke-width="8" stroke-linejoin="round">
				<polygon points="110,99 241,26 240,64 139,116"/>
				<polygon points="241,26 369,99 333,116 240,64"/>
				<polygon points="101,116 130,131 130,244 101,229"/>
				<polygon points="346,134 374,119 374,252 346,268"/>
			</g>
			<polygon points="101,116 130,131 130,244 101,229" fill="url(#rb-shade-l)" stroke="url(#rb-shade-l)" stroke-width="8" stroke-linejoin="round"/>
			<polygon points="346,134 374,119 374,252 346,268" fill="url(#rb-shade-r)" stroke="url(#rb-shade-r)" stroke-width="8" stroke-linejoin="round"/>
			<g fill="url(#rb-mark)">
				<rect x="216" y="107" width="48" height="48" rx="8" transform="rotate(45 240 131)"/>
				<path d="M240 160 V185 M185 210 V185 H295 V210" fill="none" stroke="url(#rb-mark)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
				<rect x="161" y="207" width="48" height="46" rx="9"/>
				<rect x="271" y="207" width="48" height="46" rx="9"/>
				<path d="M80 158 C -16 200 -10 324 205 342 C 308 350 378 306 398 250 C 352 290 290 304 206 298 C 72 288 34 216 80 158 Z"/>
			</g>
		</svg>
	</bx:savecontent>
	<bx:output><link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,#toBase64( brandMark )#"></bx:output>
	<!-- Pinned CDN versions with Subresource Integrity. When bumping a version, recompute the hash:
	     curl -sSL <url> | openssl dgst -sha384 -binary | openssl base64 -A   (prefix with "sha384-") -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
	<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" integrity="sha384-6p9AefaqUhEVheRlj1mpAkbngHXy9mbYMrIdcIt4Jlc9lOLIablJq3bBsLOjGwZ7" crossorigin="anonymous">
	<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/duotone/style.css" integrity="sha384-UVFvhZP7fWAENUPOoq61rJg5ef6QZW0k5vpAn71041/QS4STvUcJQCGNhStZLGx9" crossorigin="anonymous">
	<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.3/dist/cdn.min.js" integrity="sha384-iZD2X8o1Zdq0HR5H/7oa8W30WS4No+zWCKUPD7fHRay9I1Gf+C4F8sVmw7zec1wW" crossorigin="anonymous" defer></script>
	<style>
		:root{
			--rb-accent: #5b5ef4;
			--rb-sidebar-bg: #14161f;
			--rb-state-executed: #16a34a;
			--rb-state-skipped: #94a3b8;
			--rb-state-stopped: #2563eb;
			--rb-state-failed: #dc2626;
		}
		body{ min-height: 100vh; }
		.rb-shell{ min-height: 100vh; }
		.rb-sidebar{
			width: 240px;
			background: var(--rb-sidebar-bg);
			min-height: 100vh;
		}
		.rb-brand-mark svg{ display: block; height: 30px; width: auto; }
		.rb-sidebar .nav-link{ color: #cbd5e1; }
		.rb-sidebar .nav-link.active{ color: #fff; background: var(--rb-accent); border-radius: .375rem; }
		.rb-sidebar .nav-link i{ width: 1.25rem; }
		.btn-primary, .bg-primary{ background-color: var(--rb-accent) !important; border-color: var(--rb-accent) !important; }
		.text-primary{ color: var(--rb-accent) !important; }
		.rb-state-dot{ display:inline-block; width:.5rem; height:.5rem; border-radius:50%; }
		.rb-state-EXECUTED{ background: var(--rb-state-executed); }
		.rb-state-SKIPPED, .rb-state-REGISTERED, .rb-state-NOT_AVAILABLE{ background: var(--rb-state-skipped); }
		.rb-state-STOPPED{ background: var(--rb-state-stopped); }
		.rb-state-FAILED{ background: var(--rb-state-failed); }
		.rb-badge-EXECUTED{ color: var(--rb-state-executed); border-color: var(--rb-state-executed); }
		.rb-badge-SKIPPED, .rb-badge-REGISTERED, .rb-badge-NOT_AVAILABLE{ color: var(--rb-state-skipped); border-color: var(--rb-state-skipped); }
		.rb-badge-STOPPED{ color: var(--rb-state-stopped); border-color: var(--rb-state-stopped); }
		.rb-badge-FAILED{ color: var(--rb-state-failed); border-color: var(--rb-state-failed); }
		.rb-error-text{ color: var(--rb-state-failed); }
		.rb-row-failed{ --bs-table-bg-state: rgba(220, 38, 38, .12); }
		.rb-row-failed > td:first-child{ border-left: 3px solid var(--rb-state-failed); }
		.rb-errors-cell{ background: rgba(0, 0, 0, .18); }
		/* width: 0 + min-width: 100% fills the row without letting a long trace widen the table */
		.rb-error-card{ width: 0; min-width: 100%; box-sizing: border-box; padding: .75rem 1rem; border-left: 3px solid var(--rb-state-failed); margin: .25rem 0 .5rem; background: var(--bs-body-bg); border-radius: .375rem; font-family: var(--bs-body-font-family); }
		.rb-error-card + .rb-error-card{ margin-top: .75rem; }
		.rb-cause{ margin-bottom: .25rem; }
		.rb-trace{ margin: .5rem 0 0; padding: .5rem .75rem; max-height: 16rem; overflow: auto; font-size: .75rem; line-height: 1.5; white-space: pre; background: rgba(0, 0, 0, .3); border-radius: .375rem; }
		.rb-trace-raw{ color: var(--bs-secondary-color); }
		.rb-errors-toggle{ font-size: .75rem; text-decoration: none; }
	</style>
</head>
<body>
<bx:output>
	<div class="d-flex rb-shell">
		<nav class="rb-sidebar flex-shrink-0 p-3 d-flex flex-column">
			<div class="d-flex align-items-center gap-2 mb-4 px-2">
				<span class="rb-brand-mark" aria-hidden="true">#brandMark#</span>
				<span class="fs-5 fw-semibold text-white">RuleBox</span>
			</div>
			<ul class="nav nav-pills flex-column gap-1 mb-auto">
				<li class="nav-item">
					<a class="nav-link d-flex align-items-center gap-2 #( event.getCurrentAction() == 'index' ? 'active' : '' )#" href="#prc.vizLink( 'index' )#">
						<i class="ph ph-squares-four"></i> Dashboard
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link d-flex align-items-center gap-2 #( event.getCurrentAction() == 'chain' ? 'active' : '' )#" href="#prc.vizLink( 'index' )#">
						<i class="ph ph-tree-structure"></i> Rule Visualizer
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link d-flex align-items-center gap-2 #( event.getCurrentAction() == 'dryrun' ? 'active' : '' )#" href="#prc.vizLink( 'dryrun' )#">
						<i class="ph ph-flask"></i> Dry Run
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link d-flex align-items-center gap-2 #( event.getCurrentAction() == 'metrics' ? 'active' : '' )#" href="#prc.vizLink( 'metrics' )#">
						<i class="ph ph-chart-line"></i> Metrics
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link d-flex align-items-center gap-2 #( event.getCurrentAction() == 'live' ? 'active' : '' )#" href="#prc.vizLink( 'live' )#">
						<i class="ph ph-broadcast"></i> Live Tracker
					</a>
				</li>
			</ul>
			<div class="small text-secondary px-2 pt-3 border-top border-secondary-subtle">
				<div class="d-flex align-items-center gap-2 mb-1">
					<i class="ph ph-database"></i>
					<span>#htmlEditFormat( listFirst( prc.visualizerSettings.metricsStore, '@' ) )#</span>
				</div>
				<div class="d-flex align-items-center gap-2">
					<span class="rb-state-dot rb-state-EXECUTED"></span>
					<span>Visualizer enabled</span>
				</div>
			</div>
		</nav>
		<!--- min-width: 0 lets a wide table scroll inside its card instead of widening the page --->
		<main class="flex-grow-1 p-4" style="min-width: 0">
			#renderView()#
		</main>
	</div>
</body>
</html>
</bx:output>
